# ── Generated output ──────────────────────────────────────────────────────────
outputs/

# ── Figures ───────────────────────────────────────────────────────────────────
# Only the eps=0.3, N_tau=20 collapse plots are used by the paper
# (Fig. 1). The full sweep across all epsilon and N_tau values is
# regenerated by the notebook into outputs/collapse_plots/ and is not tracked.
paper/figures/*_collapse.png
!paper/figures/*_eps0.3_Ntau20_collapse.png

# ── Large / local-only data ───────────────────────────────────────────────────
Data/
course_materials/
conference template/
*.docx

